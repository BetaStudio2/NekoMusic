<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/float_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- 歌曲信息 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp"
        android:gravity="center">

        <TextView
            android:id="@+id/float_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Neko云音乐"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/float_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无播放"
            android:textSize="12sp"
            android:textColor="#E0E0E0"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 控制按钮 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/float_previous"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_previous"
            android:background="@android:color/transparent"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/float_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_widget_play"
            android:background="@android:color/transparent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/float_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_next"
            android:background="@android:color/transparent"
            android:padding="8dp" />
    </LinearLayout>
</LinearLayout>